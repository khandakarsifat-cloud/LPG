{
  "name": "lpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "accounting:db:test": "node supabase/tests/run-unified-accounting.mjs --vps",
    "accounting:actions:live:test": "node tests/summarized-actions-live.browser.mjs --vps",
    "finance:dimensions:api:test": "npm run accounting:api:test",
    "accounting:api:test": "node supabase/tests/component-live.mjs --vps && node tests/component-live.browser.mjs --vps && node supabase/tests/component-live.mjs --vps --verify && node supabase/tests/component-features-live.mjs --vps && node supabase/tests/component-live.mjs --vps --cleanup",
    "inventory:test": "node --test tests/component-display.test.ts",
    "contracts:test": "node --test tests/current-contract.test.mjs",
    "attendance:db:test": "node supabase/tests/run-attendance.mjs --vps",
    "attendance:api:test": "node supabase/tests/attendance-api.mjs --vps --browser",
    "attendance:test": "node --test attendance-receiver/*.test.mjs",
    "dashboard:credentials": "node deploy/dashboard-credentials.mjs",
    "deploy:backend": "node deploy/deploy.mjs backend",
    "deploy:frontend": "node deploy/deploy.mjs frontend",
    "deploy:all": "node deploy/deploy.mjs all",
    "deploy:test": "node --test deploy/*.test.mjs && python -m unittest discover -s deploy -p \"*_test.py\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "print:bridge": "node print-bridge/main.ts",
    "print:package": "node print-bridge/build.mjs",
    "print:standalone:test": "node --test print-bridge/packaging/*.test.mjs",
    "print:check": "tsc -p print-bridge/tsconfig.json",
    "print:test": "node --test print-bridge/*.test.ts",
    "auth:test": "node --test tests/authorization.test.ts",
    "purchase:test": "node --test tests/purchase.test.ts",
    "purchase:db:test": "node supabase/tests/run-purchases.mjs --vps",
    "auth:db:test": "node supabase/tests/run-account-access.mjs --vps",
    "auth:api:test": "node supabase/tests/run-account-access-api.mjs --vps",
    "finance:visibility:api:test": "node supabase/tests/finance-visibility-live.mjs --vps && node tests/finance-visibility.browser.mjs --vps && node supabase/tests/finance-visibility-live.mjs --vps --verify && node supabase/tests/finance-visibility-live.mjs --vps --cleanup",
    "rebate:api:test": "node supabase/tests/purchase-rebate-live.mjs --vps && node tests/purchase-rebate.browser.mjs --vps && node supabase/tests/purchase-rebate-live.mjs --vps --verify && node supabase/tests/purchase-rebate-live.mjs --vps --cleanup",
    "backup:live:test": "node tests/manual-backup-live.mjs --vps"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "date-fns": "^4.4.0",
    "jspdf": "4.2.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.22",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "rolldown": "1.0.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "4.149.0"
  }
}
