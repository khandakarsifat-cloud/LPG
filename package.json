{
  "name": "lpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "deploy:backend": "node deploy/deploy.mjs backend",
    "deploy:frontend": "node deploy/deploy.mjs frontend",
    "deploy:all": "node deploy/deploy.mjs all",
    "deploy:test": "node --test deploy/*.test.mjs && python -m unittest discover -s deploy -p \"*_test.py\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "print:bridge": "node print-bridge/server.ts",
    "print:check": "tsc -p print-bridge/tsconfig.json",
    "print:test": "node --test print-bridge/*.test.ts",
    "auth:test": "node --test tests/authorization.test.ts",
    "auth:db:test": "node supabase/tests/run-authorization.mjs",
    "auth:api:test": "node --env-file=.env supabase/tests/authorization-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "4.149.0"
  }
}
