{$API_DOMAIN} {
    header Strict-Transport-Security "max-age=31536000"
    @api path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/* /graphql/v1*
    handle @api {
        reverse_proxy api-gw:8000
    }
    handle {
        # Studio uses Envoy's dashboard Basic Auth. Do not expose its local MCP
        # bypass or the direct metadata/function routes through this fallback.
        @private path /mcp* /api/mcp* /pg* /functions*
        respond @private "Not found" 404
        reverse_proxy api-gw:8000
    }
}
