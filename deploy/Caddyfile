{$API_DOMAIN} {
    header Strict-Transport-Security "max-age=31536000"
    @untrustedOrigin {
        header Origin *
        not {
            header Origin https://floral-dew-443b.khandakarsifat.workers.dev
            header Origin https://{$API_DOMAIN}
        }
    }
    @api path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/* /graphql/v1*
    route {
        # Preserve this order: reject untrusted browser origins before any API
        # or dashboard handler. Caddy otherwise sorts handle before respond.
        respond @untrustedOrigin "Origin not allowed" 403
        @receiverRPC path /rest/v1/rpc/attendance_receive*
        respond @receiverRPC "Not found" 404
        handle /iclock/* {
            request_body {
                max_size 512KB
            }
            reverse_proxy attendance-receiver:8080 {
                # Always replace client-supplied forwarding/authentication data.
                header_up X-ADMS-Source {remote_host}
                header_up X-ADMS-TLS {tls_version}
                header_up -Authorization
                header_up -Cookie
            }
        }
        handle @api {
            reverse_proxy api-gw:8000
        }
        handle {
            # Studio uses Envoy's dashboard Basic Auth. Do not expose its local
            # MCP bypass or direct metadata/function routes through fallback.
            @private path /mcp* /api/mcp* /pg* /functions*
            respond @private "Not found" 404
            reverse_proxy api-gw:8000
        }
    }
}
